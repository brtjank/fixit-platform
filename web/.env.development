# API mode:
#   mock  - every request is served by MSW from an in-memory dataset (no backend needed)
#   live  - real backend endpoints hit the API (via Vite proxy); endpoints the backend
#           does not implement yet are still served by MSW (see docs/API_GAPS.md)
VITE_API_MODE=mock

# Base URL for API calls. Leave empty to use the Vite dev proxy (/api -> VITE_PROXY_TARGET).
VITE_API_URL=

# Where the Vite dev proxy forwards /api requests (backend from `dotnet run --project src/FixIt.Api`).
VITE_PROXY_TARGET=http://localhost:5177
